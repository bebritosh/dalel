# Copy to .env and adjust. Never commit the real .env.

# Database (SQLite file, relative to project root).
DATABASE_URL=sqlite:///data/dalel.db

# Where uploaded documents are stored on disk (uuid filenames only).
DATA_DIR=data

# Upload limit in bytes (15 MB).
MAX_UPLOAD_BYTES=15728640

# LLM extraction mode: fixture (offline, default) | live (Anthropic API).
LLM_MODE=fixture

# Anthropic API (only used when LLM_MODE=live).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# OCR engine: fixture (offline layout fixtures, default) | tesseract (needs install).
OCR_ENGINE=fixture
# OCR languages for Tesseract. Default rus+eng; add kaz if needed (rus+kaz+eng).
OCR_LANGS=rus+eng
# Optional explicit path to tesseract.exe if it is not on PATH.
TESSERACT_CMD=
