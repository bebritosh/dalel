# Copy to .env and adjust. Never commit the real .env.

# Database (SQLite file, relative to project root).
DATABASE_URL=sqlite:///data/dalel.db

# Where uploaded documents are stored on disk (uuid filenames only).
DATA_DIR=data

# Upload limit in bytes (15 MB).
MAX_UPLOAD_BYTES=15728640

# LLM extraction mode:
#   fixture (offline, default) | openai | live (Anthropic) | rules (rule-based baseline, no LLM)
#   | auto (known sha256 -> fixtures, unknown -> live Tesseract OCR + openai if key else rules).
# NOTE: in openai/live modes the receipt OCR text is sent to an external provider.
LLM_MODE=fixture

# OpenAI API (used when LLM_MODE=openai, or auto with a key).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Opt-in: save real LLM responses to eval/fixtures/{sha}.json (synthetic data only!).
SAVE_LLM_FIXTURES=0

# Anthropic API (only used when LLM_MODE=live; current ids: claude-opus-5-5, claude-sonnet-5-5, claude-haiku-5-5).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OCR engine: fixture (default) | tesseract (needs install) | auto (LLM_MODE=auto forces this).
OCR_ENGINE=fixture
# OCR languages for Tesseract. Default rus+eng; add kaz if needed (rus+kaz+eng).
OCR_LANGS=rus+eng
# Optional explicit path to tesseract.exe if it is not on PATH.
TESSERACT_CMD=
